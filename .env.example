# CoverIt API / full-stack Docker environment
# Copy to .env when running coverit-api/docker.sh or coverit-frontend/docker.sh.

# Docker image tags used by the full-stack launchers.
# API_TAG=dev
# FRONTEND_TAG=dev
# DOCGEN_TAG=dev
# CRAWLER_TAG=dev
# REGRESSION_TAG=dev

# Local Docker infrastructure.
POSTGRES_HOST_PORT=15432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=coverit
NEO4J_PASSWORD=password

# API runtime.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@db:5432/coverit
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-in-production
INTERNAL_SERVICE_TOKEN=change-me-for-internal-services
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_SECONDS=604800
RESET_TOKEN_TTL_SECONDS=3600
CACHE_TTL_SECONDS=60
API_PREFIX=/api/v1
MANUAL_SESSION_TICKET_TTL_SECONDS=60

# Frontend / CORS.
CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true
FRONTEND_URL=http://localhost:5173

# OAuth providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback

# Atlassian / Jira OAuth.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_CALLBACK_URL=http://localhost:3000/api/v1/oauth/jira/callback
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_TTL_SECONDS=600

# Email.
RESEND_API_KEY=
RESET_PASSWORD_EMAIL=Coverit <support@updates.coverit.cyou>
NOTIFICATION_EMAIL=Coverit <notifications@updates.coverit.cyou>
RESET_PASSWORD_TEMPLATE_ID=
ISSUE_CREATED_TEMPLATE_ID=
ISSUE_FAILED_TEMPLATE_ID=
CODE_GENERATED_TEMPLATE_ID=
CODE_GENERATION_FAILED_TEMPLATE_ID=

# Regression artifact storage.
DAGSHUB_BASE_URL=https://dagshub.com
DAGSHUB_OWNER=
DAGSHUB_BUCKET_NAME=
DAGSHUB_TOKEN=
DAGSHUB_ARTIFACT_PREFIX=artifacts/
REGRESSION_ARTIFACT_MAX_BYTES=104857600

# Queues used by API and crawler.
CRAWL_ARQ_QUEUE_NAME=arq:queue
MANUAL_ARQ_QUEUE_NAME=arq:manual-recordings
CRAWL_ARQ_EXPIRES_MS=86400000

# Optional compose overrides for worker containers.
# The defaults below are for containers on the Docker network.
CRAWLER_DATABASE_URL=postgresql://postgres:postgres@db:5432/coverit?schema=public
CRAWLER_REDIS_URL=redis://redis:6379/0
CRAWLER_NEO4J_URI=bolt://neo4j:7687
CRAWLER_API_INTERNAL_URL=http://api:3000/api/v1
REGRESSION_DATABASE_URL=postgresql://postgres:postgres@db:5432/coverit
REGRESSION_REDIS_HOST=redis
REGRESSION_REDIS_PORT=6379
REGRESSION_REDIS_PASSWORD=
